{
  "name": "card-game-electronization",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "predev": "npm run generate:icons && npm run materialize:battlefield && npm run materialize:stage07-ui && npm run materialize:v2",
    "dev": "vite",
    "prebuild": "npm run generate:icons && npm run materialize:battlefield && npm run materialize:stage07-ui && npm run materialize:v2",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "materialize:battlefield": "node scripts/materialize-battlefield.mjs",
    "materialize:stage07-ui": "node scripts/materialize-stage07-ui.mjs",
    "postbuild": "node scripts/build-service-worker.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "materialize:v2": "node scripts/materialize-v2.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.13.5",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
